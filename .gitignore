docs/internal/*
docs/kickstarter/

# 扩展板 V4 的内部过程文档：review 待办、验板草案、采购/下单/勘误、外壳待办等。
# 这些是开发过程记录，不是给最终用户的交付物，永远不进公开仓库。
hardware/expansion-board-v4/internal/

# 扩展板 V3（已归档）同理：验板/交接/天线研究/约束/采购记录只留本地。
hardware/expansion-board-v3/internal/

# Per-developer plan / spec working directory (superpowers workflow).
# Each agent / developer accumulates plans + specs locally; these are
# work-in-progress notes, not project deliverables, and should never
# enter the shared history. (We learned the hard way after some agent
# committed superpowers/ contents into unrelated firmware commits —
# scrubbed via git-filter-repo on 2026-05-21.)
docs/superpowers/
.superpowers/

# ── 本地密钥 ──────────────────────────────────────────────────────────
# 任何真实密钥只许待在 .env 里。要提交的模板是 .env.example（只写占位符）。
# 本仓库开源到外网，这几行是硬红线，任何时候都不要放开。
.env
.env.local
.env.*.local

# ── i18n 批量翻译工具（按要求本地保留，不进外网仓库）──────────────────
# translate_catalog.py **本身不含任何密钥**：API key 一律从 .env / 环境变量
# 读，脚本里连占位常量都没有。单就安全而言它可以开源；这条忽略是流程决定
# （产品负责人要求翻译脚本不进外网仓库），不是安全决定。
#
# 日后若要开源 / 让团队共用（后续还有 5 种语言要补齐，这是团队活），
# 删掉下面两行即可，脚本不用改。使用说明在 firmware/scripts/README.md，
# 那份是提交的。
firmware/scripts/translate_catalog.py
firmware/scripts/.i18n_translate_cache/

# Per-machine ESP-IDF Manager (eim) install path; each developer's tree
# differs and bringing this into git churns on every machine switch.
eim_config.toml

# Reference-only library: xtrsdr is consulted for URB tuning patterns,
# never built into our firmware. Keep it out of version control.
firmware/components/xtrsdr/

# ESP-IDF build artifacts
firmware/build/
firmware/build_*/
firmware/network_adapter_esp32c6.bin
firmware/sdkconfig
# sdkconfig 的所有衍生副本一网打尽——原来只列了 .old 和 .broken-backup-*，
# 结果 sdkconfig.bak 成了漏网之鱼。这类文件会随手产生，逐个补规则追不上。
firmware/sdkconfig.*
firmware/managed_components/
firmware/dependencies.lock
**/.cache/
.DS_Store

IMPLEMENTATION_PLAN.md
__pycache__

# 本地临时工作区：抓的串口日志、试编译出来的整棵 ESP-IDF 构建树等等。
# 这些产物里带着本机绝对路径（$HOME/.espressif/...），一次 `git add -A`
# 就会把上百个文件连同用户名一起提交到这个开源仓库。放什么随意，但不进 git。
/tmp/

# ── 数据文件工作区（datafiles/）─────────────────────────────────────
# 盒子要用的离线数据：机型库/航空数据 .bin（各 8~17 MB）、离线底图 .pmtiles
# （单包最大 1.4 GB，四个包合计 3.4 GB）。全部是脚本可再生的产物，体积也远
# 超任何仓库该扛的量级，只忽略内容物、保留目录结构与说明。
# 每个文件从哪来、怎么重新生成、拷到 SD 卡的什么位置，见 datafiles/README.md。
/datafiles/**/*.bin
/datafiles/**/*.pmtiles

# Object and compiler intermediate files
*.o
*.obj
*.d
*.a

# 例外：3D 外壳的 .obj 是几何模型（嘉立创下单用），不是编译中间产物
!docs/jlc/**/*.obj

# EasyEDA raw-export backups (kept locally, not tracked)
*.ori

# Design mockups / interactive prototypes — local design references only,
# never project deliverables. (traffic_radar_interactive.html slipped into
# c28c071 the same way superpowers/ did; git rm --cached'd and ignored here.)
/traffic_radar_interactive.html
/traffic_radar_mockup.png
/pfd_mockup_v6.png

# Playwright MCP 会话产物（浏览器快照/日志），非项目资产
.playwright-mcp/
.playwright-cli/
.codex-tmp/

# 本地一次性产物 / 工具缓存：漏在仓库根的散件，不进公开仓库
/kicad/
/outputs/
/jlc_prices.json
/expansion-board-v3-drc.rpt
/gerber-top.png

# 硬件工程的中间产物：DSN/SES、布线中间盘、Gerber 对拍、装配图的 SVG/HTML，
# 以及 headless Chrome 出 PDF 时留下的 profile（一个就 133MB）。
# 全是可再生成的，而且这个仓库是公开的 —— 漏进去代价大。
hardware/*/build/

# PC 模拟器构建产物
# 用 build*/ 通配：按分辨率会开多个构建目录（build = 320，build800 = 4.3″），
# 只写死 build/ 会把新开的那个漏进版本库。
sim/build*/
sim/*.bmp
sim/frame_*.bmp

# KiCad 10 自带 Local History（嵌套 git 仓库，会挡住父仓库提交）
hardware/**/.history/
# KiCad 备份与缓存
hardware/**/*-backups/
hardware/**/fp-info-cache
hardware/expansion-board-v3/fab/

# ── 临时截图 / 抓取产物 ────────────────────────────────────────────
# 本仓库是公开的。截图里常带账号、二维码、订单号这类东西，
# 一旦被 git add -A 扫进去、推上去，按 SHA 永远能取回。
*-login.png
taobao-*.png

# ── 航空数据库密钥 ────────────────────────────────────────────────────
# 由 firmware/scripts/gen_aero_key.py 从 .env 的 PK_AERO_KEY 构建时生成。
# 含 AES-128 密钥（虽然拆成两半异或，但异或两半都在文件里，等于明文）。
# 本仓库是公开的，这个文件绝不能进去。
firmware/main/pk_aero_key.h

# Excel/LibreOffice 临时锁文件
.~*.xlsx
.~lock.*

# freerouting 中间文件
hardware/*/kicad/freerouting.dsn
hardware/*/kicad/temp-freerouting.dsn
