/*
 * edgecap.pio — 双沿间隔捕获：每个边沿（上升+下降）推送"距上一边沿的 tick 数"
 * （1 tick = 2 SM 周期；SM 默认 125MHz → 16ns/tick）。X 预载 0xFFFFFFE0
 * （set x,31 + mov x,~x 两个已知常数合成），高低两段相位都在同一个 X 上递减。
 *
 * 两条推送路径的恒定开销逐指令相等（mov/push/set/mov = 4 拍 + 转换 2 拍，
 * 合计 6 拍 = 3 tick），所以换算常数统一为 +3：true_ticks = (PRELOAD − raw) + 3，
 * 下取整、误差 ≤1 tick（16ns）。饱和（X 减到 0 停住）推送 ≈PRELOAD+3 的超大
 * 值 = 空闲标记，与解码器 ">5µs 关 burst" 语义一致。
 *
 * R11（P0）：必须捕获双沿——真实 Mode-S 里 bit0→bit1 的两个 0.5µs 脉冲背靠背
 * 融合成 1µs 连续高电平；只有双沿（上升+下降）加脉宽才能把融合串重建为
 * 两个半位，只捕获上升沿会丢掉 bit1 的定位信息（融合规则本体即上文两条
 * 推送路径；PIO 原值 → 真实间隔 tick 的换算合同见
 * firmware/test/test_edgecap_convert.c 文件头）。
 */
.program edgecap
.wrap_target
    set x, 31
    mov x, ~x
low_wait:                ; 低电平：等上升沿
    jmp pin rise
    jmp x-- low_wait
    jmp low_wait         ; X 饱和：继续等沿
rise:                    ; 上升沿 → 推送（低电平时长）
    mov isr, x
    push noblock         ; RX FIFO 满则丢这一沿（奇偶错乱的 burst 由解码端整帧丢弃）
    set x, 31
    mov x, ~x
high_wait:               ; 高电平：等下降沿
    jmp pin high_cnt
    jmp fall
high_cnt:
    jmp x-- high_wait
    jmp high_wait
fall:                    ; 下降沿 → 推送（高电平时长）
    mov isr, x
    push noblock
    set x, 31
    mov x, ~x
    jmp low_wait
.wrap

% c-sdk {
/* 返回实际应用的 sm_config：宿主（edge_cap.c）保存一份，供 lost 重启
 * 路径做完整确定性重初始化（pio_sm_init 需要同款配置）。
 * FIFO join（DMA 时序缓解，2026-09-05 审计）：TX 侧并入 RX，RX FIFO 变
 * 8 深——0.5µs 最短边沿间隔下把块边界 IRQ 重武装窗口的缓冲预算从 2µs
 * 翻倍到 4µs（时序预算合同见 edge_cap.h）。本程序从不 push TX，join 无
 * 副作用；配置随返回值被宿主保存，pio_sm_init 重装路径同样生效。 */
static inline pio_sm_config edgecap_program_init(PIO pio, uint sm, uint offset, uint pin)
{
    pio_sm_config c = edgecap_program_get_default_config(offset);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_in_pin_base(&c, pin);
    sm_config_set_in_shift(&c, false, false, 32);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);
    gpio_pull_down(pin);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
    return c;
}
%}
