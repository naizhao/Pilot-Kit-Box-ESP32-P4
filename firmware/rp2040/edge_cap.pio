/*
 * edgecap.pio — 双沿间隔捕获：每个边沿（上升+下降）推送"距上一边沿的 tick 数"
 * （1 tick = 2 SM 周期；SM 默认 125MHz → 16ns/tick）。X 预载 0xFFFFFFE0
 * （set x,31 + mov x,~x 两个已知常数合成），高低两段相位都在同一个 X 上递减。
 *
 * 上升沿先延迟约 88ns 复查：V4.9 实板在 TLV3501→GPIO19 抓到大量 48–80ns
 * 高毛刺，若每个都 push，会以百万级边沿/秒淹没 FIFO/DMA。复查时已经回落就
 * 直接回 low_wait、不产生 FIFO 项；合法 Mode-S 0.5µs 脉冲则通过。这里是
 * 「延迟复查」而不是模拟低通，不能声称检查窗口内每一拍都连续为高；CPU 层
 * 仍保留 <12 tick 流式合并作为第二道保护。
 *
 * 拒绝路径必须时间守恒：从保存 ISR 到回到 low_wait 共 12 个 SM cycle，路径
 * 上恰有 6 次 x--，每次代表 2 cycle，故被吞掉的毛刺及控制开销全部并回随后
 * 的 low 间隔，不会每次毛刺偷偷压短时间基。low 推送值仍取首次上升沿时保存
 * 的 X，原有 +3 tick 换算不变。接受路径在复查后才重载 X，因此 high 的固定
 * 前导时间由宿主 +8 tick 补回。饱和（X 减到 0 停住）推送
 * ≈PRELOAD+3 的超大值 = 空闲标记，与解码器 ">5µs 关 burst" 语义一致。
 *
 * R11（P0）：必须捕获双沿——真实 Mode-S 里 bit0→bit1 的两个 0.5µs 脉冲背靠背
 * 融合成 1µs 连续高电平；只有双沿（上升+下降）加脉宽才能把融合串重建为
 * 两个半位，只捕获上升沿会丢掉 bit1 的定位信息（融合规则本体即上文两条
 * 推送路径；PIO 原值 → 真实间隔 tick 的换算合同见
 * firmware/test/test_edgecap_convert.c 文件头）。
 */
.program edgecap
.wrap_target
    set x, 31
    mov x, ~x
low_wait:                ; 低电平：等上升沿
    jmp pin rise
    jmp x-- low_wait
    jmp low_wait         ; X 饱和：继续等沿
rise:                    ; 上升沿 → 推送（低电平时长）
    mov isr, x            ; 保存首次上升沿处的 low 时长
    ; 延迟复查。拒绝路径的非计数指令与 x-- 各 6 条：12 cycle = 6 tick。
    jmp x-- db1
db1:
    jmp db2
db2:
    jmp x-- db3
db3:
    jmp db4
db4:
    jmp x-- db5
db5:
    jmp db6
db6:
    jmp x-- db7
db7:
    jmp db8
db8:
    jmp x-- db_pin
db_pin:
    jmp pin rise_ok
    jmp x-- low_wait      ; 毛刺：第 6 次递减，完整计入 low
rise_ok:
    push noblock          ; 推送首次上升沿保存的 low；满则安全丢帧
    set x, 31
    mov x, ~x             ; high 从复查后开始计，前导由宿主 +8 tick 补回
    jmp high_wait
high_wait:               ; 高电平：等下降沿
    jmp pin high_cnt
    jmp fall
high_cnt:
    jmp x-- high_wait
    jmp high_wait
fall:                    ; 下降沿 → 推送（高电平时长）
    mov isr, x
    push noblock
    set x, 31
    mov x, ~x
    jmp low_wait
.wrap

% c-sdk {
/* 返回实际应用的 sm_config：宿主（edge_cap.c）保存一份，供 lost 重启
 * 路径做完整确定性重初始化（pio_sm_init 需要同款配置）。
 * FIFO join（DMA 时序缓解，2026-09-05 审计）：TX 侧并入 RX，RX FIFO 变
 * 8 深——0.5µs 最短边沿间隔下把块边界 IRQ 重武装窗口的缓冲预算从 2µs
 * 翻倍到 4µs（时序预算合同见 edge_cap.h）。本程序从不 push TX，join 无
 * 副作用；配置随返回值被宿主保存，pio_sm_init 重装路径同样生效。 */
static inline pio_sm_config edgecap_program_init(PIO pio, uint sm, uint offset, uint pin)
{
    pio_sm_config c = edgecap_program_get_default_config(offset);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_in_pin_base(&c, pin);
    sm_config_set_in_shift(&c, false, false, 32);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);
    gpio_pull_down(pin);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
    return c;
}
%}
