# Application-local source overlay; shared ESP-IDF remains unchanged.
get_filename_component(_PK_SD_TRANSACTION_SAFETY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(pk_enable_sd_transaction_safety)
    idf_component_get_property(sd_target esp_driver_sdmmc COMPONENT_LIB)
    idf_component_get_property(sd_directory esp_driver_sdmmc COMPONENT_DIR)
    idf_build_get_property(build_directory BUILD_DIR)
    idf_build_get_property(python PYTHON)
    set(original "${sd_directory}/src/sd_trans_sdmmc.c")
    set(generator "${_PK_SD_TRANSACTION_SAFETY_ROOT}/scripts/prepare_sd_transaction_safety.py")
    set(overlay "${build_directory}/sd_transaction_safety/sd_trans_sdmmc.c")
    execute_process(COMMAND "${python}" "${generator}" --source "${original}" --output "${overlay}"
                    RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Could not prepare project SDMMC transaction overlay: ${error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${generator}")
    get_target_property(sources "${sd_target}" SOURCES)
    set(updated_sources)
    set(matches 0)
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${sd_directory}")
        if(absolute STREQUAL original)
            list(APPEND updated_sources "${overlay}")
            math(EXPR matches "${matches} + 1")
        else()
            list(APPEND updated_sources "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected exactly one SDMMC transaction translation unit, found ${matches}")
    endif()
    set_property(TARGET "${sd_target}" PROPERTY SOURCES "${updated_sources}")
    target_include_directories("${sd_target}" PRIVATE "${sd_directory}/src" "${_PK_SD_TRANSACTION_SAFETY_ROOT}/main")
endfunction()
