# Pilot Kit Box (ESP32-P4) default sdkconfig.
# Generated to capture only the non-default settings the project requires.
# Run `idf.py menuconfig` to override; this file seeds a fresh sdkconfig.

# --- Target -----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32p4"

# --- Pilot Kit Box features -------------------------------------------------
# BLE 默认开。C6 需要一次性烧 esp_hosted slave 固件（见
# docs/hardware/c6_slave_firmware-zh_CN.md），CI 或还没烧的板子可以设 n。
#
# 注意：main.c 里 ble_gatt_init() 必须排在 pk_display_init() **之前**，否则
# DSI PHY 抢 LDO 会让 C6 起不来，表现为整机 26 秒一重启。详见那里的注释。
CONFIG_PK_BLE_ENABLED=y

# --- ESP32-P4 silicon revision ---------------------------------------------
# IDF v6.0 defaults to P4 ECO5 (v3.1+). The Waveshare ESP32-P4-WIFI6 boards
# in our supply chain still ship with the original v1.x silicon (one of
# our test boards reports v1.3), so the bootloader refuses to start until
# we opt into the v0.x/v1.x family. Hardware revisions ≥ 3.0 are NOT
# binary-compatible with this build — if a v3.x P4 ever shows up we'll
# have to ship a second sdkconfig variant.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# --- External PSRAM (32 MB stacked HEX, on-die with ESP32-P4NRW32) ----------
# The ESP32-P4NRW32 chip on the Waveshare board ships with 32 MiB of
# in-package HEX (16-line) PSRAM. ESP-IDF defaults to PSRAM disabled, so
# without these knobs the firmware only has ~455 KiB of internal SRAM —
# not enough to bring up ESP-Hosted's SDIO mempool, NimBLE, the IQ ring
# buffer and the LCD framebuffer at the same time.
#
# We:
#   - turn on PSRAM in HEX mode at 200 MHz (v1.x silicon doesn't allow
#     250 MHz; the option is hidden by ESP32P4_SELECTS_REV_LESS_V3),
#   - route plain malloc() into PSRAM for any allocation > 16 KiB so
#     small DMA-sensitive buffers stay in internal RAM, and
#   - reserve 64 KiB of internal RAM for the things that absolutely
#     need it (USB/SDIO DMA descriptors, BLE controller scratch).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allow EXT_RAM_BSS_ATTR-tagged statics (PFD/BLE scratch tables) to land
# in PSRAM. Without this, those ~10 KiB of large static arrays sit in
# internal RAM .bss and starve ESP-Hosted's early-boot mempools + the
# FreeRTOS timer task stack alloc.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- USB Host stack ---------------------------------------------------------
# RTL-SDR dongles enumerate a single device but some ship via a hub bridge.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# Increase the control-transfer descriptor cap so we can read RTL2832U's
# config/string descriptors without short reads.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512

# --- FreeRTOS ---------------------------------------------------------------
# 2 MSPS bursts need responsive ISR/event handling.
CONFIG_FREERTOS_HZ=1000

# --- Logging ----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- Memory -----------------------------------------------------------------
# RTL-SDR async pipeline holds 15 x 6.4 KiB = ~96 KiB of in-flight URBs in
# DMA-capable internal RAM. Keep the main task stack modest, give the
# heap room to breathe.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- Compiler ---------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# --- Bluetooth (NimBLE host over ESP-Hosted VHCI) ---------------------------
# ESP32-P4 has no native BT controller; the controller lives on the on-board
# ESP32-C6 and is exposed to the P4 over SDIO via ESP-Hosted. From NimBLE's
# point of view this is a VHCI controller with no UART or SPI knobs to set.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# We act as GATT *server* for our app-facing characteristics, but also as
# GATT *client* toward iOS's Current Time Service after each connect.
# NimBLE compiles in ble_gattc_* only when ROLE_CENTRAL is enabled; the
# role flag is just a code-gate, we never actively scan or initiate
# connections.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
# Bump MTU so a single GDL90 Traffic Report (≤62 B) fits in one ATT PDU.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# Default NimBLE transport for a "controller disabled" host is the H4 UART
# bound to a couple of fixed GPIOs (4/5 at 921600). We don't have a real
# UART HCI — the BT controller lives on the C6 and the HCI rides over
# ESP-Hosted's SDIO VHCI shim instead. Turn UART off so NimBLE picks up
# the hosted VHCI transport that esp_hosted's BT support installs.
CONFIG_BT_NIMBLE_TRANSPORT_UART=n

# --- ESP-Hosted (P4 ↔ C6 transport for BT/Wi-Fi remote) ---------------------
# Waveshare ESP32-P4-WIFI6 wires C6 via SDIO slot 1 on these GPIOs:
#   CLK=18 CMD=19 D0=14 D1=15 D2=16 D3=17 RESET=54
# None of the upstream P4 dev-board presets match, so we run with NONE and
# set the pins explicitly. Wi-Fi remote stays off — Phase 3b is BLE only.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# Rev1.2 connects P4 GPIO54 directly to C6 EN through R34 (0 ohm);
# there is no inverter or level shifter. Hardware testing nevertheless
# confirms that this ESP-Hosted option must remain ACTIVE_HIGH for this
# project. Treat it as verified driver-option semantics, not as evidence
# of board-level inversion. ACTIVE_LOW causes 0x107 CMD5 failures.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y

# Shrink ESP-Hosted's per-bus packet pools. Defaults are 20×1536 B per
# direction, which becomes ~47 KiB of DMA-capable internal RAM per
# pool — and on the v1.x P4 with the early-boot heap fragmentation
# pattern we get, the second pool fails to find a 64-byte-aligned
# contiguous block. 8 deep queues are still plenty for BLE-only
# traffic (we don't use Wi-Fi remote), and the pool footprint drops
# to ~29 KiB which fits comfortably.
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=8

# --- Flash & Partitions -----------------------------------------------------
# Waveshare ESP32-P4-WIFI6 ships 32 MB on-board Nor flash. Use the full chip
# size and our custom partition table that reserves a 16 MiB LittleFS volume
# for ADS-B ts-format dump files.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- FATFS fast seek（microSD 随机读）---------------------------------------
# f_lseek 默认要顺着 FAT 簇链一路爬到目标偏移，耗时与「偏移 / 簇大小」成正比
# ——文件越大越慢。地图瓦片是 1.46 GB 的 pmtiles 里随机取 64 KB，正好是这条
# 路径的最坏情况。fastseek 在 open() 时一次性建好 CLMT（簇位置表），之后
# lseek 变成常数时间查表。
#
# 实测（本盒子真机 2026-08，同一张卡同一批文件，开/关各跑两轮取一致值）：
#   裸 fseeko+fread，定种子随机偏移 ×64：
#     /sdcard/maps/pk_map_cn.pmtiles 1.46 GB  64 KB 读  184.1 → 18.3 ms（10×）
#     /sdcard/aero/pk_aero.bin      11.45 MB   4 KB 读   10.4 →  6.4 ms
#   真实瓦片加载路径（pk_tile_loader 的 16 张 z9 瓦片，find/read 分段均值）：
#     find  87.4 → 1.6 ms      read  91.6 → 3.8 ms
#     单张 total 286.4 → 102.4 ms，16 张墙钟 2162 → 770 ms
#   （剩下那 ~100 ms 是 PNG 解码，与本开关无关。）
#
# BUFFER_SIZE 单位是 32-bit 字。CLMT 的格式是
#   [0]=表容量，随后每个「连续簇片段」占 2 个字（长度, 起始簇），末尾 1 个 0，
# 所以 N 个字能装下 (N-2)/2 个碎片；完全连续的文件只需要 4 个字。取 64 能容
# 31 个碎片，对这几个「往空卡上一次性拷进去」的大文件绰绰有余，而不是照抄
# 基准工程那个拍脑袋的 512。
#
# 内存：每个**只读**打开的文件占 64 × 4 = 256 B（写模式不建表，
# record_sink_file.c 的录制写入路径完全不受影响）。pk_sdcard.c 挂载参数
# max_files = 8，最坏 8 × 256 = 2 KiB。且 CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
# （SPIRAM_USE_MALLOC 打开时默认就是 y），CLMT 优先落 PSRAM，不吃那 66 KB 的
# 早期内部堆预算（check_early_heap.py 的门槛）。
#
# 注意：缓冲区装不下碎片表时 vfs_fat.c 会**回退**到普通 seek，只打一条
# W "fast-seek not activated reason code: 17"。换卡/换文件后要盯这条日志，
# 出现即说明该文件碎片超过 31 段，需要调大这里或整理文件。
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64

# --- LittleFS storage / TWDT timeout ----------------------------------------
# The 16 MiB `storage` partition takes ~5 s to mount because LittleFS has no
# on-disk index and must scan every block's metadata at boot. That scan runs
# inside SPI flash critical sections that disable cache + suspend the other
# CPU, so IDLE0 physically cannot run — let alone reset its TWDT entry —
# until mount finishes. That is an ESP32 dual-core architectural fact, not
# a bug; the only knob we have is the TWDT deadline. Raise it from the 5 s
# default to 15 s so mount has ~3× headroom while we still catch genuine
# runaway tasks. (We deliberately do NOT enable CONFIG_LITTLEFS_WDT_RESET:
# its esp_task_wdt_reset() calls only affect the caller's own TWDT entry,
# do nothing for IDLE0, and would just spam "task not found" warnings on
# every fwrite() from the unsubscribed rec_file writer task.)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# ── LVGL v9（4.3″ 触摸 UI）────────────────────────────────────────
#
# ESP-IDF 版 LVGL 走 Kconfig 而不是 lv_conf.h：组件自带的 Kconfig 默认定义
# LV_CONF_SKIP，所有 LV_* 选项都从 sdkconfig 来。桌面版那套 lv_conf.h +
# LV_CONF_PATH 在这里用不上——试过，预处理器要的是带引号的字符串，而且与
# 组件已定义的 LV_CONF_INCLUDE_SIMPLE 互相打架。
#
# 模拟器侧仍用 sim/lv_conf.h（那边是原生桌面构建），两处配置须保持一致。

CONFIG_LV_COLOR_DEPTH_16=y

# 大端 RGB565：pk_rgb565() 在源头就按面板线序交换好了，LVGL 需要对应的混合
# 实现，才能正确地与 PFD 图层做 alpha 合成。
CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED=y

# 中文走 TinyTTF：一份约 30 KB 的子集轮廓服务所有字号，比每档预渲染一份
# CJK 位图省得多（见 firmware/scripts/gen_lv_font.py）。
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_FILE_SUPPORT=n

# 用不到的一律关掉——app 分区实测只剩 471 KB。ThorVG 尤其大，而 PFD 全部
# 自绘、控件只用基本图形，矢量引擎无处可用。
CONFIG_LV_USE_THORVG_INTERNAL=n
CONFIG_LV_USE_LOG=n

# FAB 图标用内置符号，字号按视觉稿的 3.2 mm ≈ 27 px 取最近档。
CONFIG_LV_FONT_MONTSERRAT_28=y

# 二级页 backbar 的拉丁回退档。backbar 的文字几乎全是拉丁页名，回退档就是它
# 实际的字号，所以这一档必须按**视觉高度**挑，不能照抄 PK_AA_M 的标称 18 px：
# 页面标题那侧是 B612 Mono 位图，18 px 标称量出来大写字高 16 px；Montserrat 18
# 量出来只有 13 px——同一个数字，屏幕上细一圈。22 档量出来正好 16 px，与
# PK_AA_M 齐平（TinyTTF 那侧同步取 22，CJK 字身 19 px vs PK_AA_M 的 18 px）。
CONFIG_LV_FONT_MONTSERRAT_22=y

# 不编 LVGL 自带的 examples / demos：白白拖长编译，产物也都会被 gc-sections
# 丢掉。
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# 地图页（pk_tile_loader.c）解码 PMTiles 里的 PNG 栅格瓦片要用。只调
# lodepng_decode32() 这一个函数，不走 lv_image/lv_fs 那一整套。
# LV_USE_LODEPNG 不开:瓦片 PNG 解码走 main/third_party/pk_lodepng(上游原版,
# 纯 malloc 线程安全)。LVGL 那份被 patch 成 lv_draw_buf_t*+lv_malloc(非线程安全),
# 且与 vendored 版同名符号,同开会链接冲突。
# CONFIG_LV_USE_LODEPNG is not set

# ── esp_hosted：BT feature gate ───────────────────────────────────
#
# 新版 esp_hosted 把蓝牙拆成了可选 feature（default n）；旧版没有这一层，
# BT 是默认可用的。升级后不显式打开，ble_gatt.c 里的
# esp_hosted_bt_controller_init/enable 两个兼容宏就不会被定义，编译直接报
# implicit declaration。
#
# 本项目的 BLE GDL90 输出依赖它，必开。
CONFIG_PK_BATT_DIVIDER_X100=296
